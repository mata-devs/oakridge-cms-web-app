                hotspot[get(hs_info)].loadstyle(hs_info_card);
                copy(hotspot[get(hs_info)].ath,hotspot[get(h)].ath);
                copy(hotspot[get(hs_info)].atv,hotspot[get(h)].atv);
                <!-- copy(hotspot[get(hs_info)].parent, get(hs_circle2)); -->
